//kage:unit pixels

package main

// Scanlines shader: the line structure of a 240-line console picture
// on a CRT, 240 bright lines with a dark gap between each pair. The
// lines are laid over the picture's rows in the destination, so their
// count and placement stay fixed whatever resolution the emulated
// frame has and however it is scaled. Each line's brightness follows
// a smooth profile across its height, full at the center and dimmed
// at the gap, so a picture height that is not a whole multiple of the
// line count shows no beat between lines of differing pixel heights.

// PictureTop and PictureHeight are the rows the picture covers in the
// destination, in pixels. Rows outside the picture are left alone.
var PictureTop float
var PictureHeight float

// Lines is the number of bright lines across the picture's height.
const Lines = 240.0

// GapDepth is how far the gap between lines dims, 0 none to 1 black.
const GapDepth = 0.25

// MinLinePixels is the smallest line height in pixels the lines are
// drawn at; below it they are narrower than a pixel and are skipped.
const MinLinePixels = 2.0

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	clr := imageSrc0At(srcPos)
	y := dstPos.y - PictureTop
	if y < 0.0 || y >= PictureHeight || PictureHeight < Lines*MinLinePixels {
		return clr
	}

	// Position across the line, 0 at its top edge and 1 at the next
	// line's; the profile is full at 0.5 and dimmed by GapDepth at the
	// edges.
	phase := fract(y * Lines / PictureHeight)
	dim := GapDepth * (0.5 + 0.5*cos(2.0*3.14159265*phase))
	clr.rgb *= 1.0 - dim
	return clr
}
